flowchart TB
  root["live/root.hcl"]
  devAcc["live/dev/account.hcl"]
  prdAcc["live/prd/account.hcl"]

  subgraph devRegion ["live/dev/us-east-1"]
    devVpc["vpc/terragrunt.hcl"]
    devEcr["ecr/terragrunt.hcl"]
    devEks["eks/terragrunt.hcl"]
    devMon["monitoring/terragrunt.hcl"]
    devEks -->|"dependency vpc"| devVpc
    devMon -.->|"generate helm_provider + cluster_name"| devEks
  end

  subgraph prdRegion ["live/prd/us-east-1"]
    prdVpc["vpc/terragrunt.hcl"]
    prdEcr["ecr/terragrunt.hcl"]
    prdEks["eks/terragrunt.hcl"]
    prdMon["monitoring/terragrunt.hcl"]
    prdEks -->|"dependency vpc"| prdVpc
    prdMon -.->|"generate helm_provider + cluster_name"| prdEks
  end

  subgraph modules ["modules/"]
    modVpc["vpc/"]
    modEcr["ecr/"]
    modEks["eks/"]
    modMon["monitoring/"]
  end

  root --> devAcc
  root --> prdAcc
  devAcc --> devRegion
  prdAcc --> prdRegion
  devVpc --> modVpc
  devEcr --> modEcr
  devEks --> modEks
  devMon --> modMon
  prdVpc --> modVpc
  prdEcr --> modEcr
  prdEks --> modEks
  prdMon --> modMon
